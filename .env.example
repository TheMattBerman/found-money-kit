# Optional. Needed only for an explicitly authorized private HubSpot read.
# Never committed. The kit does not persist this value.
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional. Needed only for an explicitly authorized private Stripe read.
# Restricted key. Runtime mode must match test or live. Never committed.
STRIPE_API_KEY=

# Optional live-enable flag for found-money private-run. Leave unset.
# This kit never sets the flag for you.
# FOUND_MONEY_PRIVATE_RUN_LIVE=

# Optional. Extra HubSpot deal-stage ids to treat as recovery candidates, comma
# separated. Custom pipeline stage ids are specific to your portal, so they are
# configured here rather than hardcoded in the kit. The standard `qualifiedtobuy`
# and `closedlost` stages are always included.
# FOUND_MONEY_EXTRA_DEAL_STAGES=

# Optional. Private client or business proper nouns that must never appear in a
# public artifact, comma separated. The safety scanners fail closed on these in
# addition to their built-in placeholder list.
# FOUND_MONEY_CLIENT_NOUNS=
